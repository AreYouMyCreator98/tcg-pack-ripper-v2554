{
  "name": "tcg-pack-ripper-plus",
  "version": "0.260.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "assets": "node scripts/generate-asset-manifest.mjs",
    "test": "node --test tests/*.test.mjs tests/legacy/*.test.mjs",
    "validate": "node scripts/generate-asset-manifest.mjs && node scripts/validate-project.mjs && node --test tests/*.test.mjs tests/legacy/*.test.mjs && node scripts/make-static-deploy.mjs && node scripts/smoke-static.mjs",
    "build": "node scripts/generate-asset-manifest.mjs && node node_modules/vite/bin/vite.js build && node scripts/build-precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "release:check": "pnpm run validate && pnpm run build && pnpm run smoke:production",
    "serve:static": "vite preview --host 127.0.0.1",
    "smoke:production": "node scripts/smoke-static.mjs --production",
    "cap:sync": "pnpm exec cap sync",
    "cap:add:android": "pnpm exec cap add android",
    "cap:add:ios": "pnpm exec cap add ios",
    "cap:open:android": "pnpm exec cap open android",
    "cap:open:ios": "pnpm exec cap open ios",
    "deploy:static": "node scripts/generate-asset-manifest.mjs && node scripts/make-static-deploy.mjs",
    "smoke:static": "node scripts/make-static-deploy.mjs && node scripts/smoke-static.mjs",
    "test:hub": "node --test tests/trade-hub*.test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "linkedom": "0.18.13",
    "supabase": "2.119.0",
    "vite": "8.3.2"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
